{
  "manifest_version": 3,
  "name": "Don't Start Without Me",
  "version": "0.7.0",
  "description": "Watch together, in sync, from different countries. YouTube, Netflix, Apple TV and Shahid.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.netflix.com/*",
    "https://tv.apple.com/*",
    "https://shahid.mbc.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Don't Start Without Me",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content/adapters/netflix-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.netflix.com/*",
        "https://tv.apple.com/*",
        "https://shahid.mbc.net/*"
      ],
      "js": [
        "content/sync-math.js",
        "content/adapters/registry.js",
        "content/adapters/youtube.js",
        "content/adapters/netflix.js",
        "content/adapters/appletv.js",
        "content/adapters/shahid.js",
        "content/core.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://celestial-darkgreen-hyena-82.hostingersite.com/join/*",
        "http://localhost/join/*"
      ],
      "js": [
        "content/invite.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
